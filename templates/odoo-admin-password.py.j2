import os

login = os.environ.get("ODOO_ADMIN_USER_LOGIN") or {{ odoo_admin_user_login | to_json }}
admin = env["res.users"].search([("login", "=", login)], limit=1)
if not admin and login == "admin":
    admin = env.ref("base.user_admin", raise_if_not_found=False)
if not admin:
    raise SystemExit("admin user not found: %s" % login)

password = os.environ["ODOO_ADMIN_PASSWORD"]
if not admin.check_password(password):
    admin.password = password
    env.cr.commit()
    print("admin_password=changed")
else:
    print("admin_password=unchanged")
