# systemd-enabled EL image for the integration scenario.
#
# Used only for images that ship the systemd *unit files* but not the systemd
# package itself (e.g. rockylinux/rockylinux:9 -- no /usr/sbin/init and no
# /usr/lib/systemd/systemd), so the role could not manage services. Install
# systemd and trim the units that only make sense on a real machine so the
# container boots cleanly to multi-user.target under /usr/sbin/init. This is the
# same trimming the well-known systemd container images use.
#
# Images that already run systemd as PID 1 (the AlmaLinux *-init images) set
# MOLECULE_ODOO_PREBUILT=true; molecule then skips this build entirely.
FROM {{ item.image }}

ENV container=docker

# RHEL-family images ship /etc/shadow mode 0000. Recent runc no longer gives
# the setuid 'unix_chkpwd' helper CAP_DAC_OVERRIDE, so pam_unix's account phase
# cannot read it and every sudo/become fails with "PAM account management
# error: Authentication service cannot retrieve authentication info". Making
# the file owner-readable lets real uid 0 read it without that capability.
# See linux-pam/linux-pam#876 and geerlingguy/docker-rockylinux9-ansible#6.
# (prepare.yml applies the same chmod for prebuilt images.)
RUN dnf -y install systemd \
    && dnf clean all \
    && chmod 0400 /etc/shadow \
    && ln -sf /usr/lib/systemd/systemd /usr/sbin/init \
    && rm -f /lib/systemd/system/multi-user.target.wants/* \
    && rm -f /etc/systemd/system/*.wants/* \
    && rm -f /lib/systemd/system/local-fs.target.wants/* \
    && rm -f /lib/systemd/system/sockets.target.wants/*udev* \
    && rm -f /lib/systemd/system/sockets.target.wants/*initctl* \
    && rm -f /lib/systemd/system/basic.target.wants/* \
    && rm -f /lib/systemd/system/anaconda.target.wants/*

CMD ["/usr/sbin/init"]
